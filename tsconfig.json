{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    /* The SDK's package.json "exports" map has no "types" entry, so bundler resolution cannot see its
       declarations. Point TypeScript at them directly; Vite still resolves the runtime module via "exports". */
    "paths": {
      "@payroll-integrations/onboarding-sdk": ["./node_modules/@payroll-integrations/onboarding-sdk/dist/src/main.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"]
}
